DEBUG=true

SECRET_KEY=

POSTGRES_DB=fuel_route
POSTGRES_USER=fuel_route
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org
ORS_CONNECT_TIMEOUT_SECONDS=5
ORS_READ_TIMEOUT_SECONDS=30
ORS_GEOCODE_DELAY_SECONDS=0.15
# Cap each geocode run to stay under a ~3000/day ORS quota (leave headroom for /fuel-plan/ routing).
ORS_GEOCODE_MAX_API_REQUESTS_PER_RUN=2800
# Set to 0 for unlimited ORS geocode calls per run (paid / higher quota plans only).

# Bulk geocoding without ORS quota (public Nominatim — ~1 req/s, finish ~6k rows in ~2–3 hours)
NOMINATIM_USER_AGENT=FuelRoutePlanner/0.1 (your-email@example.com)
NOMINATIM_DELAY_SECONDS=1.1
NOMINATIM_MIN_REQUEST_INTERVAL_SECONDS=1.0
NOMINATIM_TIMEOUT_SECONDS=30
GEOCODE_DB_BATCH_SIZE=100

# Faster bulk geocoding (free signup at locationiq.com — separate from ORS quota)
LOCATIONIQ_API_KEY=
LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1
LOCATIONIQ_MIN_REQUEST_INTERVAL_SECONDS=0.5
LOCATIONIQ_TIMEOUT_SECONDS=30

ROUTE_CACHE_TIMEOUT_SECONDS=86400
ORS_GEOCODE_CACHE_TIMEOUT_SECONDS=86400
ORS_ROUTING_PROFILE=driving-car
ORS_ROUTING_CACHE_VERSION=1
ROUTE_COORDINATE_CACHE_DECIMALS=4
# Optional production cache backend (requires: pip install redis)
# REDIS_URL=redis://redis:6379/1

ROUTE_STATION_CORRIDOR_MILES=5

VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10

CENSUS_GEOCODER_BATCH_URL=https://geocoding.geo.census.gov/geocoder/locations/addressbatch
CENSUS_GEOCODER_BENCHMARK=Public_AR_Current
CENSUS_GEOCODER_BATCH_SIZE=1000
CENSUS_GEOCODER_TIMEOUT_SECONDS=60
CENSUS_GEOCODER_MAX_RETRIES=3
CENSUS_GEOCODER_RETRY_BACKOFF_SECONDS=2
